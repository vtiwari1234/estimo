{
  "name": "estimo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estimo: free, real-time planning poker for agile teams",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "dev:pro": "vite --mode pro",
    "build:pro": "vite build --mode pro",
    "deploy:pro": "npm run build:pro && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/voting.e2e.mjs",
    "e2e:pro": "node e2e/pro.e2e.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
